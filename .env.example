# Google Analytics 4 — Measurement ID (public, sent to the browser)
# Get yours at https://analytics.google.com (Admin -> Data Streams -> Measurement ID)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console — site verification token (server-side only)
# Get yours at https://search.google.com/search-console (URL-prefix -> HTML tag)
GOOGLE_SITE_VERIFICATION=
